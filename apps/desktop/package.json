{
  "name": "@teneo/desktop",
  "version": "0.4.2-beta.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vue-tsc -b && vite build --base=./",
    "preview": "vite preview",
    "test": "bun test backend scripts src",
    "typecheck": "vue-tsc -b && tsc -p backend/tsconfig.json --noEmit",
    "test:runtime": "bun scripts/run-on-tjs.ts backend/sync/storage.tjs.ts && bun scripts/run-on-tjs.ts backend/sync/transport.tjs.ts && bun scripts/run-on-tjs.ts backend/sync/dns-sd-registry.tjs.ts",
    "local-ai:build": "bun scripts/build-local-ai.ts",
    "local-ai:smoke": "bun scripts/test-local-ai.ts",
    "local-ai:publish-models": "bun scripts/publish-local-ai-models.ts",
    "sync:peer": "bun scripts/run-on-tjs.ts backend/sync/peer.tjs.ts",
    "sync:check": "bun scripts/check-sync-peers.ts",
    "release:key": "bun scripts/create-update-key.ts",
    "release:publish": "bun scripts/publish-release.ts",
    "release:github-settings": "bun scripts/github-settings.ts",
    "release:secrets": "bun scripts/set-signing-secrets.ts"
  },
  "dependencies": {
    "@sentry/vue": "11.14.0",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/vue-query": "^5.104.3",
    "@tanstack/vue-virtual": "^3.13.45",
    "@teneo/shared": "workspace:*",
    "@teneo/sync": "workspace:*",
    "@teneo/ui": "workspace:*",
    "@vueuse/core": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.1",
    "reka-ui": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "uqr": "^0.1.3",
    "vue": "catalog:",
    "vue-sonner": "catalog:"
  },
  "devDependencies": {
    "@iconify-json/tabler": "catalog:",
    "@iconify/vue": "^5.0.3",
    "@sentry/vite-plugin": "^11.14.0",
    "@txikijs/types": "26.6.0",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/tsconfig": "catalog:",
    "esbuild": "^0.28.2",
    "shadcn-vue": "^2.8.2",
    "tw-animate-css": "catalog:",
    "typescript": "catalog:",
    "unplugin-icons": "catalog:",
    "vite": "catalog:",
    "vue-tsc": "catalog:"
  }
