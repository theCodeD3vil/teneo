<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: sync from adb (see DebugSyncReceiver) -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- exported so `adb shell am broadcast` can reach it, and held to
             android.permission.DUMP, which only the shell and the system
             have: no other app can send to it -->
        <receiver
            android:name=".sync.DebugSyncReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
