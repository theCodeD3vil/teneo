<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only. Release builds have no sync service yet: when sync
     ships, the permissions and a (non-exported) service entry for the app's
     own subclass of SyncService go in the main manifest instead. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- what a connectedDevice service has to hold at least one of; this one
         is the one for network connections -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- the permanent notification; the user can still turn it off -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!-- exported so `adb shell am start-foreground-service` can reach it,
             and held to android.permission.DUMP, which only the shell and the
             system have: no other app can start it -->
        <service
            android:name=".sync.DebugSyncService"
            android:exported="true"
            android:foregroundServiceType="connectedDevice"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
