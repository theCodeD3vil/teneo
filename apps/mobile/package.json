{
  "name": "@teneo/mobile",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5175 --strictPort",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b",
    "android:build": "bun run build && CI=true cap sync android && mise exec -- ./android/gradlew -p android :app:assembleDebug",
    "android:run": "bun run android:build && adb install -r android/app/build/outputs/apk/debug/app-debug.apk && adb shell am start -n com.michael.teneo/.MainActivity"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2",
    "@fontsource-variable/figtree": "5.3.0",
    "@tailwindcss/vite": "catalog:",
    "@teneo/ui": "workspace:*",
    "tailwindcss": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@iconify-json/tabler": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/tsconfig": "catalog:",
    "tw-animate-css": "catalog:",
    "typescript": "catalog:",
    "unplugin-icons": "catalog:",
    "vite": "catalog:",
    "vue-tsc": "catalog:"
  }
}
