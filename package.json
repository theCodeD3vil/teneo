{
  "name": "teneo-monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@iconify-json/tabler": "^1.2.42",
      "@tailwindcss/vite": "^4.3.3",
      "@types/node": "^24.13.3",
      "@vitejs/plugin-vue": "^6.0.8",
      "@vue/tsconfig": "^0.9.1",
      "@vueuse/core": "^15.0.0",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "reka-ui": "^2.11.0",
      "tailwind-merge": "^3.7.0",
      "tailwindcss": "^4.3.3",
      "tw-animate-css": "^1.4.0",
      "typescript": "~6.0.2",
      "unplugin-icons": "^24.0.0",
      "vite": "^8.3.0",
      "vue": "^3.5.42",
      "vue-sonner": "^2.0.9",
      "vue-tsc": "^3.3.11"
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "desktop": "cd apps/desktop && tinyjs dev",
    "site": "turbo run dev --filter=@teneo/site",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "turbo": "^2.11.11"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": "bun run lint",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "packageManager": "bun@1.4.0"
}
